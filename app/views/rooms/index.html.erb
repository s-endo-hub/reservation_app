<div class="search-box">
  <%= form_with url: rooms_path, method: :get, local: true do |f| %>
    <div class="search-fields">
      <div>
        <%= f.label :area, "エリア" %>
        <%= f.text_field :area, placeholder: "東京、大阪、京都、札幌" %>
      </div>

      <div>
        <%= f.label :keyword, "キーワード" %>
        <%= f.text_field :keyword, placeholder: "施設名や説明" %>
      </div>

      <%= f.submit "検索" %>
    </div>
  <% end %>
</div>

<p><%= @rooms.count %>件の施設が見つかりました</p>

<% if @rooms.any? %>
  <div class="room-list">
    <% @rooms.each do |room| %>
      <div class="room-card">
        <% if room.image.attached? %>
          <%= image_tag room.image, width: 150 %>
        <% else %>
          <%= image_tag "default_room.png", width: 150 %>
        <% end %>

        <p>施設名：<%= room.name %></p>
        <p>説明：<%= room.description %></p>
        <p>料金：<%= number_to_currency(room.price, unit: "¥", format: "%u%n", precision: 0) %> / 泊</p>
        <p>住所：<%= room.address %></p>

        <%= link_to "詳細を見る", room_path(room) %>
      </div>
    <% end %>
  </div>
<% else %>
  <p>登録した施設はありません。</p>
<% end %>
