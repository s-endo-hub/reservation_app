<header>
    <%= link_to "Potepan Share", rooms_path %>

    <% if user_signed_in? %>
    <details>
        <summary>
        <% if current_user.icon.attached? %>
            <%= image_tag current_user.icon, width: 40, height: 40 %>
        <% else %>
            <%= image_tag "default_icon.png", width: 40, height: 40 %>
        <% end %>

        <span><%= current_user.name %></span>
        <span>▼</span>
        </summary>

        <div>
        <%= link_to "施設の新規登録", new_room_path %>
        <%= link_to "予約済み一覧", reservations_path %>
        <%= link_to "登録済み一覧", my_rooms_path %>
        <%= link_to "アカウント設定", users_show_path %>

        <hr>

        <%= button_to "ログアウト",
                        destroy_user_session_path,
                        method: :delete %>
        </div>
    </details>

    <% else %>
    <div class="header-auth-links">
        <%= link_to "ログイン", new_user_session_path %>
        <%= link_to "新規登録", new_user_registration_path %>
    </div>
    <% end %>
</header>
