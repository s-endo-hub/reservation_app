<h1>予約一覧</h1>

<% if @reservations.any? %>
  <div class="reservation-list">

    <div class="reservation-list-header">
      <span>画像</span>
      <span>施設名</span>
      <span>紹介文</span>
      <span>合計料金</span>
      <span>チェックイン</span>
      <span>チェックアウト</span>
      <span>予約確定日時</span>
    </div>

    <% @reservations.each do |reservation| %>
      <div class="reservation-row">

        <div>
          <% if reservation.room.image.attached? %>
            <%= image_tag reservation.room.image %>
          <% else %>
            <%= image_tag "default_room.png" %>
          <% end %>
        </div>

        <div>
          <%= reservation.room.name %>
        </div>

        <div>
          <%= reservation.room.description %>
        </div>

        <div>
          <%= number_to_currency(
                reservation.room.price *
                (reservation.checkout_at - reservation.checkin_at).to_i *
                reservation.guest_count,
                unit: "¥",
                format: "%u%n",
                precision: 0
              ) %>
        </div>

        <div>
          <%= reservation.checkin_at.strftime("%Y/%m/%d") %>
        </div>

        <div>
          <%= reservation.checkout_at.strftime("%Y/%m/%d") %>
        </div>

        <div>
          <%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %>
        </div>

        <%= button_to "予約を削除",
              reservation_path(reservation),
              method: :delete,
              data: { turbo_confirm: "この予約を削除しますか？" } %>
        
      </div>
    <% end %>

  </div>
<% else %>
  <p>予約はありません。</p>
<% end %>
