<h1>プロフィール編集</h1>

<%= form_with model: @user, url: update_profile_path, method: :patch do |f| %>
  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :bio, "自己紹介" %>
    <%= f.text_area :bio %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>