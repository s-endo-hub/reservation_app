<h2>アカウント編集</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
<%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email, "メールアドレス" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

<% if devise_mapping.confirmable? && resource.pending_reconfirmation? %> <div>
現在、確認メールの送信待ちです：
<%= resource.unconfirmed_email %> </div>
<% end %>

  <div class="field">
    <p>
      <%= f.label :password, "新しいパスワード" %>
    </p>
    <p>
      <small>パスワードを変更しない場合は空欄にしてください。</small>
    </p>
    <p>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </p>


<% if @minimum_password_length %>
  <p>
    <small><%= @minimum_password_length %>文字以上で入力してください。</small>
  </p>
<% end %>

  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "新しいパスワード（確認）" %></p>
    <p>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </p>
  </div>

  <div class="field">
    <p>
      <%= f.label :current_password, "現在のパスワード" %>
    </p>
    <p>
      <small>変更内容を確認するため、現在のパスワードを入力してください。</small>
    </p>
    <p>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </p>
  </div>

  <div class="actions">
    <%= f.submit "変更を保存する" %>
  </div>
<% end %>

<h3>アカウントの削除</h3>

<p>
  アカウントを削除すると、元に戻すことはできません。
</p>

<%= button_to "アカウントを削除する",
registration_path(resource_name),
data: {
turbo_confirm: "本当にアカウントを削除しますか？"
},
method: :delete %>

<%= link_to "戻る", :back %>
